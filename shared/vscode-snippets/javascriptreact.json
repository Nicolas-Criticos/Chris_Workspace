{
  "Samsara Standard Component": {
    "prefix": "scomp",
    "body": [
      "import { cn } from '@/lib/utils'",
      "",
      "// ── TYPES ──────────────────────────────────────────────────────────────────",
      "",
      "interface ${1:ComponentName}Props {",
      "\t${2:children?: React.ReactNode}",
      "\tclassName?: string",
      "}",
      "",
      "// ── COMPONENT ───────────────────────────────────────────────────────────────",
      "",
      "/**",
      " * ${3:Description of what this component does.}",
      " *",
      " * @param className - Optional Tailwind class override for composition",
      " */",
      "export default function ${1:ComponentName}({ ${4:children}, className }: ${1:ComponentName}Props) {",
      "\treturn (",
      "\t\t<div className={cn('${5:base-styles}', className)}>",
      "\t\t\t${0}",
      "\t\t</div>",
      "\t)",
      "}"
    ],
    "description": "Standard Samsara component with props interface, JSDoc, and cn() override"
  },

  "Samsara Page Component": {
    "prefix": "spage",
    "body": [
      "import { useState } from 'react'",
      "import { use${1:Feature}s } from '@/lib/${2:domain}/queries'",
      "import ${1:Feature}List from './components/${1:Feature}List'",
      "import LoadingSpinner from '@/components/ui/LoadingSpinner'",
      "import ErrorState from '@/components/ui/ErrorState'",
      "import PageLayout from '@/components/layout/PageLayout'",
      "",
      "// ── PAGE ────────────────────────────────────────────────────────────────────",
      "",
      "/**",
      " * ${1:Feature} page — view layer only. All data access via use${1:Feature}s().",
      " * Follows: Component → Hook → API → Supabase",
      " */",
      "export default function ${1:Feature}Page() {",
      "\t// ── DATA ────────────────────────────────────────────────────────────────",
      "",
      "\tconst {",
      "\t\tdata: ${3:items} = [],",
      "\t\tisLoading,",
      "\t\tisError,",
      "\t\terror,",
      "\t\trefetch,",
      "\t} = use${1:Feature}s()",
      "",
      "\t// ── STATE ───────────────────────────────────────────────────────────────",
      "",
      "\tconst [selected, setSelected] = useState<${4:Item} | null>(null)",
      "",
      "\t// ── GUARDS ──────────────────────────────────────────────────────────────",
      "",
      "\tif (isLoading) return <LoadingSpinner />",
      "\tif (isError)   return <ErrorState message={error?.message} onRetry={refetch} />",
      "",
      "\t// ── RENDER ──────────────────────────────────────────────────────────────",
      "",
      "\treturn (",
      "\t\t<PageLayout title='${5:Page Title}'>",
      "\t\t\t<${1:Feature}List",
      "\t\t\t\t${3:items}={${3:items}}",
      "\t\t\t\tonSelect={setSelected}",
      "\t\t\t/>",
      "",
      "\t\t\t{selected && (",
      "\t\t\t\t<${6:DetailModal}",
      "\t\t\t\t\titem={selected}",
      "\t\t\t\t\tonClose={() => setSelected(null)}",
      "\t\t\t\t/>",
      "\t\t\t)}",
      "\t\t\t${0}",
      "\t\t</PageLayout>",
      "\t)",
      "}"
    ],
    "description": "Full page component: data + loading + error + state + render (3-layer pattern)"
  },

