    "body": [
      "import Modal from '@/components/ui/Modal'",
      "import Button from '@/components/ui/Button'",
      "",
      "// ── TYPES ──────────────────────────────────────────────────────────────────",
      "",
      "interface ${1:ModalName}Props {",
      "\topen: boolean",
      "\tonClose: () => void",
      "\t${2:// add extra props here}",
      "}",
      "",
      "// ── COMPONENT ───────────────────────────────────────────────────────────────",
      "",
      "/**",
      " * ${3:Description of what this modal does.}",
      " * Uses the framework Modal (portal, Escape dismissal, aria-label).",
      " *",
      " * @param open    - Controls visibility",
      " * @param onClose - Called on backdrop click or Escape key",
      " */",
      "export default function ${1:ModalName}({ open, onClose${4:, } }: ${1:ModalName}Props) {",
      "\t// ── HANDLERS ────────────────────────────────────────────────────────────",
      "",
      "\tconst handleConfirm = () => {",
      "\t\t${5:// confirm action}",
      "\t\tonClose()",
      "\t}",
      "",
      "\t// ── RENDER ──────────────────────────────────────────────────────────────",
      "",
      "\treturn (",
      "\t\t<Modal open={open} onClose={onClose} ariaLabel='${6:Modal Title}'>",
      "\t\t\t{/* ── HEADER ── */}",
      "\t\t\t<div className='flex items-center justify-between mb-4'>",
      "\t\t\t\t<h2 className='text-xl font-semibold'>${6:Modal Title}</h2>",
      "\t\t\t</div>",
      "",
      "\t\t\t{/* ── CONTENT ── */}",
      "\t\t\t<div className='space-y-4'>",
      "\t\t\t\t${0}",
      "\t\t\t</div>",
      "",
      "\t\t\t{/* ── ACTIONS ── */}",
      "\t\t\t<div className='flex gap-2 justify-end mt-6'>",
      "\t\t\t\t<Button variant='link' onClick={onClose}>Cancel</Button>",
      "\t\t\t\t<Button onClick={handleConfirm}>${7:Confirm}</Button>",
      "\t\t\t</div>",
      "\t\t</Modal>",
      "\t)",
      "}"
    ],
    "description": "Modal component using the framework Modal (portal, Escape, aria-label)"
  },

  "Samsara Form Component": {
    "prefix": "sform",
    "body": [
      "import { useForm } from 'react-hook-form'",
      "import { useCreate${1:Entity} } from '@/lib/${2:domain}/queries'",
      "import Button from '@/components/ui/Button'",
      "import FormField from '@/components/ui/FormField'",
      "",
      "// ── TYPES ──────────────────────────────────────────────────────────────────",
      "",
      "interface ${3:FormName}Input {",
      "\t${4:name: string}",
      "}",
      "",
      "interface ${3:FormName}Props {",
      "\tonSuccess?: () => void",
      "\tonCancel?: () => void",
      "}",
      "",
      "// ── COMPONENT ───────────────────────────────────────────────────────────────",
      "",
      "/**",
      " * ${5:Description of what this form creates/edits.}",
      " * Uses react-hook-form with validation + useMutation for submission.",
      " */",
      "export default function ${3:FormName}({ onSuccess, onCancel }: ${3:FormName}Props) {",
      "\t// ── DATA ────────────────────────────────────────────────────────────────",
      "",
      "\tconst create${1:Entity} = useCreate${1:Entity}()",
      "",
      "\t// ── FORM ────────────────────────────────────────────────────────────────",
      "",
      "\tconst {",
      "\t\tregister,",
      "\t\thandleSubmit,",
      "\t\treset,",
      "\t\tformState: { errors },",
      "\t} = useForm<${3:FormName}Input>()",
      "",
      "\t// ── HANDLERS ────────────────────────────────────────────────────────────",
      "",
      "\tconst onSubmit = (data: ${3:FormName}Input) => {",
      "\t\tcreate${1:Entity}.mutate(data, {",
      "\t\t\tonSuccess: () => {",
      "\t\t\t\treset()",
      "\t\t\t\tonSuccess?.()",
      "\t\t\t},",
      "\t\t\tonError: (err) => {",
      "\t\t\t\tconsole.error('Failed to create ${1:Entity}:', err)",
      "\t\t\t},",
      "\t\t})",
      "\t}",
      "",
      "\t// ── RENDER ──────────────────────────────────────────────────────────────",
      "",
      "\treturn (",
      "\t\t<form onSubmit={handleSubmit(onSubmit)} className='space-y-4'>",
      "\t\t\t{/* ── FIELDS ── */}",
      "\t\t\t<FormField label='${6:Label}' error={errors.${4:name}?.message}>",
      "\t\t\t\t<input",
      "\t\t\t\t\t{...register('${4:name}', { required: '${6:Label} is required' })}",
      "\t\t\t\t\tclassName='input'",
      "\t\t\t\t\tplaceholder='${7:Placeholder...}'",
      "\t\t\t\t/>",
      "\t\t\t</FormField>",
      "",
      "\t\t\t{/* ── ERROR ── */}",
      "\t\t\t{create${1:Entity}.isError && (",
      "\t\t\t\t<p className='text-sm text-red-500'>{create${1:Entity}.error.message}</p>",
      "\t\t\t)}",
      "",
      "\t\t\t{/* ── ACTIONS ── */}",
      "\t\t\t<div className='flex gap-2 justify-end'>",
      "\t\t\t\t{onCancel && (",
      "\t\t\t\t\t<Button type='button' variant='link' onClick={onCancel}>Cancel</Button>",
      "\t\t\t\t)}",
      "\t\t\t\t<Button type='submit' disabled={create${1:Entity}.isPending}>",
      "\t\t\t\t\t{create${1:Entity}.isPending ? 'Saving...' : '${8:Save}'}",
      "\t\t\t\t</Button>",
      "\t\t\t</div>",
      "\t\t</form>",
      "\t)",
      "}"
    ],
    "description": "Form component with react-hook-form, validation, mutation, loading state"
  },

  "Samsara List Component": {
    "prefix": "slist",
    "body": [
      "import LoadingSpinner from '@/components/ui/LoadingSpinner'",
      "import EmptyState from '@/components/ui/EmptyState'",
      "import ${1:Item}Card from './${1:Item}Card'",
      "import type { ${1:Item} } from '@/lib/types'",
      "",
      "// ── TYPES ──────────────────────────────────────────────────────────────────",
      "",
      "interface ${1:Item}ListProps {",
      "\t${2:items}: ${1:Item}[]",
      "\tisLoading?: boolean",
      "\tonSelect?: (item: ${1:Item}) => void",
      "}",
      "",
      "// ── COMPONENT ───────────────────────────────────────────────────────────────",
      "",
      "/**",
      " * Renders a list of ${1:Item} cards with loading and empty states.",
      " */",
      "export default function ${1:Item}List({ ${2:items}, isLoading, onSelect }: ${1:Item}ListProps) {",
      "\t// ── GUARDS ──────────────────────────────────────────────────────────────",
      "",
      "\tif (isLoading) return <LoadingSpinner />",
      "\tif (${2:items}.length === 0) return <EmptyState message='No ${3:items} yet.' />",
      "",
      "\t// ── RENDER ──────────────────────────────────────────────────────────────",
      "",
      "\treturn (",
      "\t\t<ul className='${4:space-y-3}'>",
      "\t\t\t{${2:items}.map((item) => (",
      "\t\t\t\t<li key={item.id}>",
      "\t\t\t\t\t<${1:Item}Card",
      "\t\t\t\t\t\titem={item}",
      "\t\t\t\t\t\tonClick={onSelect ? () => onSelect(item) : undefined}",
      "\t\t\t\t\t/>",
      "\t\t\t\t</li>",
      "\t\t\t))}",
      "\t\t</ul>",
      "\t)",
      "}"
    ],
    "description": "List component with map + key, loading state, empty state"
  },

