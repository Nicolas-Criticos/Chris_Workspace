  "Samsara useQuery Hook": {
    "prefix": "squery",
    "body": [
      "import { useQuery } from '@tanstack/react-query'",
      "import { queryKeys } from '../queryKeys'",
      "import { fetch${1:Entity}s } from './${2:api}'",
      "",
      "/**",
      " * Fetches all ${1:Entity} records.",
      " * Throws on error — caller must handle isError.",",
      " */",
      "export function use${1:Entity}s(${3:param?: string}) {",
      "\treturn useQuery({",
      "\t\tqueryKey: queryKeys.${4:entity}.list(${3:param}),",
      "\t\tqueryFn: () => fetch${1:Entity}s(${3:param}),",
      "\t\t${5:enabled: Boolean(${3:param}),}",
      "\t})",
      "}",
      "",
      "/**",
      " * Fetches a single ${1:Entity} by ID.",
      " */",
      "export function use${1:Entity}(id: string) {",
      "\treturn useQuery({",
      "\t\tqueryKey: queryKeys.${4:entity}.detail(id),",
      "\t\tqueryFn: () => fetch${1:Entity}ById(id),",
      "\t\tenabled: Boolean(id),",
      "\t})",
      "}"
    ],
    "description": "React Query useQuery hook with queryKey factory, typed, error throw"
  },

  "Samsara useMutation Hook": {
    "prefix": "smutation",
    "body": [
      "import { useMutation, useQueryClient } from '@tanstack/react-query'",
      "import { queryKeys } from '../queryKeys'",
      "import { create${1:Entity}, update${1:Entity}, delete${1:Entity} } from './${2:api}'",
      "",
      "// ── CREATE ──────────────────────────────────────────────────────────────────",
      "",
      "export function useCreate${1:Entity}() {",
      "\tconst qc = useQueryClient()",
      "\treturn useMutation({",
      "\t\tmutationFn: create${1:Entity},",
      "\t\tonSuccess: () => {",
      "\t\t\tqc.invalidateQueries({ queryKey: queryKeys.${3:entity}.all() })",
      "\t\t},",
      "\t})",
      "}",
      "",
      "// ── UPDATE ──────────────────────────────────────────────────────────────────",
      "",
      "export function useUpdate${1:Entity}() {",
      "\tconst qc = useQueryClient()",
      "\treturn useMutation({",
      "\t\tmutationFn: ({ id, ...updates }: Partial<${4:Create${1:Entity}Input}> & { id: string }) =>",
      "\t\t\tupdate${1:Entity}(id, updates),",
      "\t\tonSuccess: (updated) => {",
      "\t\t\tqc.invalidateQueries({ queryKey: queryKeys.${3:entity}.all() })",
      "\t\t\tqc.invalidateQueries({ queryKey: queryKeys.${3:entity}.detail(updated.id) })",
      "\t\t},",
      "\t})",
      "}",
      "",
      "// ── DELETE ──────────────────────────────────────────────────────────────────",
      "",
      "export function useDelete${1:Entity}() {",
      "\tconst qc = useQueryClient()",
      "\treturn useMutation({",
      "\t\tmutationFn: delete${1:Entity},",
      "\t\tonSuccess: () => {",
      "\t\t\tqc.invalidateQueries({ queryKey: queryKeys.${3:entity}.all() })",
      "\t\t},",
      "\t})",
      "}"
    ],
    "description": "React Query mutations: create, update, delete with cache invalidation"
  },

  "Samsara Supabase API Function": {
    "prefix": "sapi",
    "body": [
      "import { supabase } from '../supabase'",
      "import type { ${1:Entity} } from '../types'",
      "",
      "// ── TYPES ──────────────────────────────────────────────────────────────────",
      "",
      "export interface Create${1:Entity}Input {",
      "\t${2:name: string}",
      "}",
      "",
      "// ── API ─────────────────────────────────────────────────────────────────────",
      "",
      "/**",
      " * Fetch ${1:Entity} by ID from Supabase.",
      " * Throws on DB error — let React Query handle the error state.",
      " */",
      "export async function fetch${1:Entity}ById(id: string): Promise<${1:Entity}> {",
      "\tconst { data, error } = await supabase",
      "\t\t.from('${3:table_name}')",
      "\t\t.select('*')",
      "\t\t.eq('id', id)",
      "\t\t.single()",
      "\tif (error) throw error",
      "\treturn data",
      "}",
      "",
      "/**",
      " * Create a new ${1:Entity} record in Supabase.",
      " */",
      "export async function create${1:Entity}(input: Create${1:Entity}Input): Promise<${1:Entity}> {",
      "\tconst { data, error } = await supabase",
      "\t\t.from('${3:table_name}')",
      "\t\t.insert(input)",
      "\t\t.select()",
      "\t\t.single()",
      "\tif (error) throw error",
      "\treturn data",
      "}"
    ],
    "description": "Supabase API function — async, typed, error throw, no hardcoded keys"
  },

  "Samsara Query Key Factory Entry": {
    "prefix": "squerykeys",
    "body": [
      "${1:entity}: {",
      "\tall:    ()           => ['${1:entity}'] as const,",
      "\tlist:   (${2:param}: ${3:string}) => ['${1:entity}', 'list', ${2:param}] as const,",
      "\tdetail: (id: string) => ['${1:entity}', id] as const,",
      "},"
    ],
    "description": "Query key factory entry for queryKeys.js — prevents typo bugs"
  },

  "Samsara Full CRUD API Module": {
    "prefix": "scrud",
    "body": [
      "import { supabase } from '../supabase'",
      "import type { ${1:Entity} } from '../types'",
      "",
      "// ── TYPES ──────────────────────────────────────────────────────────────────",
      "",
      "export interface Create${1:Entity}Input {",
      "\t${2:name: string}",
      "}",
      "",
      "export type Update${1:Entity}Input = Partial<Create${1:Entity}Input>",
      "",
      "// ── FETCH ──────────────────────────────────────────────────────────────────",
      "",
      "/**",
      " * Fetch all ${1:Entity} records, ordered by created_at descending.",
      " */",
      "export async function fetch${1:Entity}s(): Promise<${1:Entity}[]> {",
      "\tconst { data, error } = await supabase",
      "\t\t.from('${3:table_name}')",
      "\t\t.select('*')",
      "\t\t.order('created_at', { ascending: false })",
      "\tif (error) throw error",
      "\treturn data",
      "}",
      "",
      "/**",
      " * Fetch a single ${1:Entity} by primary key.",
      " */",
      "export async function fetch${1:Entity}ById(id: string): Promise<${1:Entity}> {",
      "\tconst { data, error } = await supabase",
      "\t\t.from('${3:table_name}')",
      "\t\t.select('*')",
      "\t\t.eq('id', id)",
      "\t\t.single()",
      "\tif (error) throw error",
      "\treturn data",
      "}",
      "",
      "// ── CREATE ──────────────────────────────────────────────────────────────────",
      "",
      "/**",
      " * Insert a new ${1:Entity} row and return the created record.",
      " */",
      "export async function create${1:Entity}(input: Create${1:Entity}Input): Promise<${1:Entity}> {",
      "\tconst { data, error } = await supabase",
      "\t\t.from('${3:table_name}')",
      "\t\t.insert(input)",
      "\t\t.select()",
      "\t\t.single()",
      "\tif (error) throw error",
      "\treturn data",
      "}",
      "",
      "// ── UPDATE ──────────────────────────────────────────────────────────────────",
      "",
      "/**",
      " * Update an existing ${1:Entity} row and return the updated record.",
      " */",
      "export async function update${1:Entity}(id: string, updates: Update${1:Entity}Input): Promise<${1:Entity}> {",
      "\tconst { data, error } = await supabase",
      "\t\t.from('${3:table_name}')",
      "\t\t.update(updates)",
      "\t\t.eq('id', id)",
      "\t\t.select()",
      "\t\t.single()",
      "\tif (error) throw error",
      "\treturn data",
      "}",
      "",
      "// ── DELETE ──────────────────────────────────────────────────────────────────",
      "",
      "/**",
      " * Delete a ${1:Entity} row by ID.",
      " */",
      "export async function delete${1:Entity}(id: string): Promise<void> {",
      "\tconst { error } = await supabase",
      "\t\t.from('${3:table_name}')",
      "\t\t.delete()",
      "\t\t.eq('id', id)",
      "\tif (error) throw error",
      "}"
    ],
    "description": "Full CRUD API module: fetchAll, fetchById, create, update, delete — typed, no raw keys"
  },

  "Samsara Custom Hook": {
    "prefix": "shook",
    "body": [
      "import { useState, useCallback } from 'react'",
      "import { use${1:Data} } from '@/lib/${2:domain}/queries'",
      "",
      "// ── TYPES ──────────────────────────────────────────────────────────────────",
      "",
      "interface Use${3:HookName}Return {",
      "\t${4:data}: ${5:unknown}",
      "\tisLoading: boolean",
      "\tisError: boolean",
      "\t${6:handleAction}: () => void",
      "}",
      "",
