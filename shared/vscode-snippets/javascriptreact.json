  "Samsara Component Test": {
    "prefix": "stestcomp",
    "body": [
      "import { render, screen } from '@testing-library/react'",
      "import userEvent from '@testing-library/user-event'",
      "import { describe, it, expect, vi } from 'vitest'",
      "import { QueryClientProvider, QueryClient } from '@tanstack/react-query'",
      "import type { ReactNode } from 'react'",
      "import ${1:ComponentName} from './${1:ComponentName}'",
      "",
      "// ── TEST WRAPPER ─────────────────────────────────────────────────────────────",
      "",
      "function TestWrapper({ children }: { children: ReactNode }) {",
      "\tconst queryClient = new QueryClient({",
      "\t\tdefaultOptions: { queries: { retry: false } },",
      "\t})",
      "\treturn <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>",
      "}",
      "",
      "// ── TESTS ────────────────────────────────────────────────────────────────────",
      "",
      "describe('${1:ComponentName}', () => {",
      "\tit('renders without crashing', () => {",
      "\t\trender(<${1:ComponentName} ${2:props} />, { wrapper: TestWrapper })",
      "\t\texpect(screen.getByText('${3:expected text}')).toBeInTheDocument()",
      "\t})",
      "",
      "\tit('${4:handles user interaction correctly}', async () => {",
      "\t\tconst user = userEvent.setup()",
      "\t\tconst ${5:onAction} = vi.fn()",
      "",
      "\t\trender(<${1:ComponentName} ${5:onAction}={${5:onAction}} ${2:props} />, { wrapper: TestWrapper })",
      "",
      "\t\tawait user.click(screen.getByRole('${6:button}', { name: '${7:button name}' }))",
      "",
      "\t\texpect(${5:onAction}).toHaveBeenCalledOnce()",
      "\t})",
      "",
      "\t${0}",
      "})"
    ],
    "description": "Component test template: QueryClient wrapper, render, userEvent, assertions"
  },

