      "\t// ── STATE ───────────────────────────────────────────────────────────────",
      "",
      "\tconst [${9:localState}, set${10:LocalState}] = useState<${11:boolean}>(${12:false})",
      "",
      "\t// ── HANDLERS ────────────────────────────────────────────────────────────",
      "",
      "\tconst ${6:handleAction} = useCallback(() => {",
      "\t\t${0}",
      "\t}, [])",
      "",
      "\t// ── RETURN ──────────────────────────────────────────────────────────────",
      "",
      "\treturn {",
      "\t\t${4:data}: data ?? ${13:[]},",
      "\t\tisLoading,",
      "\t\tisError,",
      "\t\t${6:handleAction},",
      "\t}",
      "}"
    ],
    "description": "Custom hook with typed return, data fetching, state, and handlers"
  },

  "Samsara useEffect with Cleanup": {
    "prefix": "seffect",
    "body": [
      "useEffect(() => {",
      "\t// ── SETUP ───────────────────────────────────────────────────────────────",
      "\t${1:let active = true}",
      "",
      "\t${2:async function load() {",
      "\t\tconst result = await ${3:fetch()}",
      "\t\tif (active) ${4:setState(result)}",
      "\t\\}}",
      "",
      "\t${2:load()}",
      "",
      "\t// ── CLEANUP ─────────────────────────────────────────────────────────────",
      "\treturn () => {",
